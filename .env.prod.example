# Django settings
DEBUG=0
SECRET_KEY=your_secret_key_here
DJANGO_ALLOWED_HOSTS=yourdomain.com www.yourdomain.com
API_URL=http://127.0.0.1:1337/api

# Database (PostgreSQL) - shared between Django and PostgreSQL service
SQL_ENGINE=django.db.backends.postgresql
SQL_DATABASE=audio-player-db
SQL_USER=gdap_user
SQL_PASSWORD=change_me_in_production
SQL_HOST=db
SQL_PORT=5432
DATABASE=postgres

# PostgreSQL service initialization (mapped from SQL_* variables above)
POSTGRES_USER=gdap_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=audio-player-db

# Email settings (to send password reset instructions from)
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1

# Django superuser (created on first run)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change_me_in_production

# Google Drive
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# PostgreSQL-specific (map from SQL_* vars)
POSTGRES_USER=${SQL_USER}
POSTGRES_PASSWORD=${SQL_PASSWORD}
POSTGRES_DB=${SQL_DATABASE}
